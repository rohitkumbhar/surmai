{
  "compilerOptions": {
    "composite": true,
    // This project also includes src and tests, so it needs the same alias as
    // tsconfig.app.json. No baseUrl: it is deprecated in TypeScript 6, and
    // without it these are resolved relative to this file.
    "paths": {
      "@src/*": [
        "./src/*"
      ]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "lib": [
      "ES2024",
      "ES2024.Object",
      "ESNext.Intl",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["vite.config.ts", "tests", "src"]
}
